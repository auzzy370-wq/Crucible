DATABASE_URL="postgresql://gauntlet:gauntlet@localhost:5432/engineering_gauntlet?schema=public"
# On Vercel: use Neon/Vercel Postgres pooled URL with sslmode=require
# Local only. On Vercel omit this or use Upstash — localhost hangs serverless login.
REDIS_URL="redis://localhost:6379"
SESSION_SECRET="replace-with-long-random-string"
SETUP_SECRET="replace-with-setup-bootstrap-secret"
APP_URL="http://localhost:3847"
NEXT_PUBLIC_APP_URL="http://localhost:3847"
STORAGE_ROOT="./storage"
# Vercel demo: process | local compose: docker
EXECUTION_MODE="process"
WORKER_CONCURRENCY="2"
# Free AI vs Human (preferred) — get a key at https://console.groq.com
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
# Optional free fallback — https://openrouter.ai
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="cohere/north-mini-code:free"
# Paid OpenAI (optional)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
# false = do not silently mock when keys are missing
AI_FALLBACK_MOCK="true"
S3_ENDPOINT="http://minio:9000"
S3_ACCESS_KEY="gauntlet"
S3_SECRET_KEY="gauntletsecret"
S3_BUCKET="gauntlet-artifacts"
S3_REGION="us-east-1"
GITHUB_TOKEN=""
GITHUB_APP_ID=""
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MAX="120"
PORT="3847"
WORKER_PORT="3848"
# Stripe Premium Checkout (optional — without these, upgrade is instant mock)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Optional local demos only — never ship these values
ALLOW_DEMO_ACCOUNTS=false
DEMO_ADMIN_PASSWORD=
DEMO_CANDIDATE_PASSWORD=
ALLOW_MOCK_BILLING=false

# Social login (optional — buttons appear when a provider's pair is set)
# Callback: {APP_URL}/api/auth/oauth/{google|github|apple|facebook|discord|x}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=

# Promote these emails to SUPER_ADMIN on login (Apple/Google/etc or password)
# Example: SUPER_ADMIN_EMAILS=you@icloud.com,you@company.com
SUPER_ADMIN_EMAILS=
# Optional: Apple subject ids if Hide My Email makes matching hard
SUPER_ADMIN_APPLE_SUBS=

# Clerk (recommended social hub) — prefer: npx clerk@latest auth login && npx clerk@latest env pull
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

